{
  "name": "pglite-electron-smoke",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "package": "electron-packager . pglite-smoke --platform=linux --arch=x64 --asar --out=out --overwrite --ignore=^/out",
    "package:mac": "electron-packager . pglite-smoke --platform=darwin --arch=arm64 --asar --out=out --overwrite --ignore=^/out"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10"
  },
  "devDependencies": {
    "@electron/packager": "18.4.4",
    "electron": "38.8.6"
  }
}
